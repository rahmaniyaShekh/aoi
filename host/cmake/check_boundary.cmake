# Platform boundary check: core code reaches the OS only through
# src/platform/*.h. Fails the build if any file under src/core includes an OS
# header (Windows, macOS or POSIX) or a platform implementation directly, or
# uses a raw Win32 API. Run on every build:
#
#   cmake -DCORE_DIR=<src/core> -DOUT=<generated header> -P check_boundary.cmake
#
# The generated header carries the numbers `aoi selftest` reports.
file(GLOB_RECURSE files "${CORE_DIR}/*.h" "${CORE_DIR}/*.cpp")
list(SORT files)

# Lowercase header names (without .h) that only a platform layer may include.
set(os_headers
  windows winbase windef winuser winnt winerror winhttp wininet winsock winsock2 ws2tcpip ws2def iphlpapi
  mmdeviceapi audioclient audiopolicy endpointvolume avrt ks ksmedia mmreg mmsystem mmiscapi
  functiondiscoverykeys functiondiscoverykeys_devpkey devpkey propsys propidl propvarutil
  objbase combaseapi unknwn shlobj shellapi shlwapi knownfolders bcrypt wincrypt ncrypt
  processthreadsapi synchapi handleapi fileapi namedpipeapi winreg tlhelp32 versionhelpers
  unistd pthread fcntl signal spawn dlfcn termios)
set(os_prefixes
  "platform/win/" "platform/mac/" "sys/" "mach/" "mach-o/" "dispatch/" "corefoundation/" "coreaudio/"
  "audiotoolbox/" "audiounit/" "avfoundation/" "screencapturekit/" "foundation/" "cocoa/")
# Raw Win32 that only compiles because some library header dragged windows.h in.
set(win32_tokens "HANDLE" "HRESULT" "DWORD" "WINAPI" "LPCWSTR" "HWND" "HMODULE" "__uuidof"
  "CoInitializeEx" "CoCreateInstance" "WaitForSingleObject" "CreateEventW" "CreateProcessW" "GetLastError"
  "Sleep" "LoadLibraryW" "GetProcAddress" "RegOpenKeyExW" "MultiByteToWideChar" "SetThreadPriority"
  "GetCurrentThread" "timeBeginPeriod" "QueryPerformanceCounter" "OutputDebugStringA")

set(violations "")
set(n_includes 0)
foreach(f ${files})
  file(STRINGS "${f}" lines)
  file(RELATIVE_PATH rel "${CORE_DIR}/.." "${f}")
  set(ln 0)
  foreach(line IN LISTS lines)
    math(EXPR ln "${ln} + 1")
    if(line MATCHES "^[ \t]*#[ \t]*include[ \t]*[<\"]([^>\"]+)[>\"]")
      math(EXPR n_includes "${n_includes} + 1")
      set(raw "${CMAKE_MATCH_1}")
      string(TOLOWER "${raw}" inc)
      get_filename_component(base "${inc}" NAME_WE)
      list(FIND os_headers "${base}" hit)
      set(bad OFF)
      if(NOT hit EQUAL -1 AND NOT inc MATCHES "/")
        set(bad ON)
      endif()
      foreach(p ${os_prefixes})
        string(FIND "${inc}" "${p}" pos)
        if(pos EQUAL 0)
          set(bad ON)
        endif()
      endforeach()
      if(bad)
        list(APPEND violations "${rel}:${ln}: includes <${raw}>")
      endif()
    else()
      string(REGEX REPLACE "//.*$" "" code "${line}")
      foreach(t ${win32_tokens})
        if(code MATCHES "(^|[^A-Za-z0-9_])${t}([^A-Za-z0-9_]|$)")
          list(APPEND violations "${rel}:${ln}: uses ${t}")
        endif()
      endforeach()
    endif()
  endforeach()
endforeach()

list(LENGTH files n_files)
list(LENGTH violations n_bad)
file(WRITE "${OUT}.tmp"
  "// Generated by cmake/check_boundary.cmake. Do not edit.\n"
  "#pragma once\n"
  "#define AOI_BOUNDARY_FILES ${n_files}\n"
  "#define AOI_BOUNDARY_INCLUDES ${n_includes}\n"
  "#define AOI_BOUNDARY_VIOLATIONS ${n_bad}\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
if(n_bad GREATER 0)
  string(REPLACE ";" "\n  " msg "${violations}")
  message(FATAL_ERROR "platform boundary violated (core must use src/platform/*.h only):\n  ${msg}")
endif()
message(STATUS "platform boundary: ${n_files} core files, ${n_includes} includes, no OS headers")
